# Slurm settings for the helpers in scripts/slurm/. Fill in this ONE file
# for your cluster (or override any variable in the environment). Empty values
# mean "do not pass the flag".
SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"           # --account
SLURM_PARTITION="${SLURM_PARTITION:-}"       # --partition (a GPU partition; training jobs are preemptible-safe)
SLURM_QOS="${SLURM_QOS:-}"                   # --qos
# Optional Pyxis/Enroot container (e.g. docker://<registry>/<image>:<tag>, built
# from docker/Dockerfile). Empty = no container: the job runs on the node itself
# and activates VENV below.
CONTAINER_IMAGE="${CONTAINER_IMAGE:-}"
CONTAINER_MOUNTS="${CONTAINER_MOUNTS:-}"     # --container-mounts, e.g. /data:/data
LOG_DIR="${LOG_DIR:-logs}"                   # sbatch stdout/stderr (relative to the repo)
# The virtualenv of the Environment section, activated inside the job (e.g.
# /path/to/repo/.venv). Empty = python is already on PATH (e.g. /opt/venv in
# the container image).
VENV="${VENV:-}"
